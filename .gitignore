# --- Unreal Engine ---

# Visual Studio / Rider generated project files
.vs/
.vsconfig
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb
*.xcodeproj
*.xcworkspace

# Build artifacts and caches (regenerated by the engine/UBT)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Generated build logs
UpgradeLog.htm

# Compiled source (rare, but ignore just in case)
*.pdb
*.exe
*.dll
*.lib
*.exp
*.patch_*

# OS junk
Thumbs.db
.DS_Store

# Local Claude Code settings (machine-specific permissions)
.claude/
